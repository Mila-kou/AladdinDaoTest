# 执行环境：dev-readonly | tx-fork | oracle-fork | time-fork | base-sepolia
E2E_ENV=tx-fork

# Trade 页面；建议保留到站点根路径，测试页面自行拼接 /trade。
E2E_APP_BASE_URL=https://fx100-dev.vercel.app
# 兼容旧配置的全局回退；新配置优先使用下面每个环境独立的固定 Chain ID。
E2E_CHAIN_ID=84532

# 实际使用时复制 example deployment manifest 为 *.local.json 后填写。
E2E_DEPLOYMENT_MANIFEST=./config/deployments/base-sepolia-v0.3.1.local.json

# 五类环境分别配置，RPC URL 可能包含访问凭证，不得提交。
E2E_DEV_RPC_URL=
E2E_TX_FORK_RPC_URL=
E2E_TX_FORK_WSS_URL=
E2E_TX_FORK_CHAIN_ID=99911
E2E_ORACLE_FORK_RPC_URL=
E2E_ORACLE_FORK_WSS_URL=
E2E_ORACLE_FORK_CHAIN_ID=99912
E2E_TIME_FORK_RPC_URL=
E2E_TIME_FORK_WSS_URL=
E2E_TIME_FORK_CHAIN_ID=99913
# 真实 Base Sepolia：Service Keeper 专项与实时参数读取；不提供 Oracle/时间管理 RPC。
E2E_BASE_SEPOLIA_RPC_URL=
E2E_BASE_SEPOLIA_WSS_URL=
E2E_BASE_SEPOLIA_CHAIN_ID=84532

# Tenderly Admin RPC；仅需要修改状态、价格或时间的环境填写。
E2E_TX_FORK_ADMIN_RPC_URL=
E2E_ORACLE_FORK_ADMIN_RPC_URL=
E2E_TIME_FORK_ADMIN_RPC_URL=

# 专用测试账户和 Tenderly API 凭证。
# 私有 fork 优先使用 impersonation，只保存地址，不要求私钥。
E2E_SIGNING_MODE=impersonation
# 跑批/CLI 显式注入的键优先于 .env.local（逗号列表；run-batches 自动填，CLI 按需传，如 E2E_ENV,E2E_TRADER_PROFILE）
E2E_ENV_PRIORITY_KEYS=
# 前端显示值观测（docs/07 Phase 1-D）：E2E_TRADER_PROFILE=ui 改用零历史专用 trader（scripts/prepare-ui-trader.ts 注资）；
# E2E_UI_COLLECT=true 在全平前停点采集平仓弹窗；UI_APP_BASE_URL 为本地前端（默认 http://localhost:3010）
E2E_TRADER_PROFILE=default
E2E_UI_TEST_ACCOUNT=
E2E_UI_TEST_PRIVATE_KEY=
E2E_UI_COLLECT=false
UI_APP_BASE_URL=http://localhost:3010
# 仅在显式签名证据运行时设为 true；该模式不会自动 evm_revert。
E2E_PERSIST_FORK_STATE=false
E2E_TEST_ACCOUNT=
E2E_KEEPER_ACCOUNT=
E2E_ADMIN_ACCOUNT=
E2E_TEST_PRIVATE_KEY=
E2E_SECONDARY_TEST_PRIVATE_KEY=
# Base Sepolia 的 Fund USDC 会校验此私钥地址等于链上 Mock USDC owner()，然后发送真实 mint 交易。
E2E_TOKEN_OWNER_PRIVATE_KEY=
# Base Sepolia Faucet 后台服务告警；敏感 Token 不回显、不写入测试报告。
E2E_TELEGRAM_BOT_TOKEN=
# Telegram 个人或群组 Chat ID；群组 ID 通常为负数。
E2E_TELEGRAM_CHAT_ID=
E2E_TENDERLY_ACCESS_TOKEN=

# reset 模式：snapshot 表示每次运行动态创建 evm_snapshot；baseline 表示使用固定 ID。
E2E_FORK_RESET_MODE=snapshot

# Keeper 的本机敏感配置来源。文件内容不复制到 TestCode，也不进入报告。
E2E_KEEPER_ENV_FILE=./tools/keeper-runner/.env

# 可选执行参数。
E2E_REQUEST_TIMEOUT_MS=30000
E2E_FORK_BASELINE_ID=
# 看板显示名称；留空时从 Fork RPC URL 的最后三段自动提取，不展示协议、域名或查询参数。
E2E_FORK_DISPLAY_NAME=

# 结果与看板元数据。RUN_ID 留空时由 Reporter 按开始时间生成。
E2E_RUN_ID=
E2E_RELEASE=release-v0.3.1
E2E_FORK_BLOCK_NUMBER=
E2E_SCENARIO_CATALOG=../TestCase/E2E/SCENARIO-CHECKLIST.md

# 看板资料页数据源：合约总结与需求总结分开显示。
E2E_SYSTEM_PARAMETERS_SOURCE=../TestCase/E2E/ContractCodeSummary/FX100-合约配置参数总表.csv
E2E_CONTRACT_FORMULAS_SOURCE=../TestCase/E2E/ContractCodeSummary/FX100-核心字段计算公式.md
E2E_PAGE_FORMULAS_SOURCE=../Docs/Gordon-Notion需求文档归档/汇总/FX100-页面字段计算公式.md

# 测试用例明细和页面编辑覆盖层。原始 scenarios Markdown 不由页面直接改写。
E2E_SCENARIO_DETAILS_DIR=../TestCase/E2E/scenarios
E2E_TEST_CASE_OVERRIDES=./config/test-case-overrides.json
