# FX100 keeper —— Base Sepolia 测试环境配置模板
#
# 用法：cp .env.example .env  然后填空。.env 不要提交、不要贴进对话。
# 这份模板与 apps/keeper/.env.example 的差异已按 chainId 84532 校正，
# 直接抄那份会跑到 Tenderly 主网 fork 上去（那是 99918）。

# ---------- 安全阀 ----------
# true  = 只验证不广播（角色没配好之前保持 true）
# false = 真发交易。确认 ORDER_KEEPER 角色已授予后再翻
KEEPER_DRY_RUN=true

# ---------- 链 ----------
KEEPER_CHAIN_ID=84532
KEEPER_HTTP_RPC_URL=
# 可选。留空则走轮询（KEEPER_EVENT_PROVIDER=auto 会自动降级）
KEEPER_WSS_RPC_URL=
KEEPER_EVENT_PROVIDER=auto
KEEPER_POLL_INTERVAL_MS=5000
KEEPER_REWIND_BLOCKS=100

# ---------- Chainlink Data Streams ----------
# executeOrder 的 SetPricesParams.data 是 Data Streams 的签名报价，
# 没有这两个凭证，订单永远执行不了——这是整条链路的硬前置。
CHAINLINK_BASE_URL=https://api.dataengine.chain.link
CHAINLINK_API_KEY=
CHAINLINK_API_SECRET=
# 84532 必须是 testnet。模板默认的 mainnet 是给 Base 主网和 Tenderly fork 用的
CHAINLINK_NETWORK=testnet

# ---------- keeper 钱包 ----------
# 必须是持有 DataStore ORDER_KEEPER 角色的地址。
# 链上当前只有部署者 0xf82cf35c…d403 持有该角色 —— 不要用部署产物里的 pk.txt，
# 请 admin 用 grantRole 授权一个新地址，把那个新地址的私钥填这里。
ORDER_KEEPER_PRIVATE_KEY=

# ---------- Redis ----------
# 本地默认 127.0.0.1:6379，装了就不用填
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

LOG_LEVEL=info
